{
  "comments": { "lineComment": "//" },
  "brackets": [["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" }
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(IF|ELSE|FOR|WHILE)\\b",
    "decreaseIndentPattern": "^\\s*(ELSE|END)\\b"
  }
}